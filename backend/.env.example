DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.ru,www.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ru,https://www.example.ru

# CORS (if frontend and backend are same domain, keep CORS_ALLOW_ALL_ORIGINS=False)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://example.ru,https://www.example.ru

# HTTPS/security (for Nginx reverse proxy)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Database settings.
# For SQLite on VPS:
POSTGRES_ENABLED=False
#
# For PostgreSQL on VPS:
# POSTGRES_ENABLED=True
# POSTGRES_DB=diplomchik
# POSTGRES_USER=diplomchik
# POSTGRES_PASSWORD=strong-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
